{
  "name": "blaze-component-lsp",
  "version": "0.2.0",
  "description": "LSP server for Meteor Blaze templates with BlazeComponent",
  "author": "Tim Nimets",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/tymnim/blaze-component-lsp.git"
  },
  "main": "server/index.js",
  "types": "types/index.d.ts",
  "bin": {
    "blaze-component-lsp": "server/index.js",
    "blaze-check": "cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./server/index.js"
    },
    "./types": {
      "types": "./types/index.d.ts",
      "default": "./types/index.d.ts"
    }
  },
  "files": [
    "server",
    "cli",
    "types",
    "client/neovim",
    "client/sublime",
    "client/vscode/extension.js",
    "client/vscode/package.json",
    "client/vscode/syntaxes",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node server/index.js --stdio",
    "check": "node cli/index.js",
    "test": "node --test test/**/*.test.js",
    "test:parsers": "node --test test/parsers/*.test.js",
    "test:indexer": "node --test test/indexer/*.test.js",
    "test:providers": "node --test test/providers/*.test.js",
    "test:typescript": "node --test test/typescript/*.test.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "typescript": "^5.8.3",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=20.0.0"
  }
}
