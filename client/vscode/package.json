{
  "name": "blaze-component-lsp",
  "displayName": "Blaze Component LSP",
  "description": "Language server support for Meteor Blaze templates with BlazeComponent — completions, hover, go-to-definition, and diagnostics in HTML template files.",
  "version": "0.1.0",
  "publisher": "blaze-component-lsp",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:html",
    "workspaceContains:.meteor"
  ],
  "main": "./extension.js",
  "contributes": {
    "grammars": [
      {
        "scopeName": "text.html.spacebars",
        "path": "./syntaxes/spacebars.tmLanguage.json",
        "injectTo": ["text.html.basic", "text.html.derivative"],
        "embeddedLanguages": {}
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Blaze Component LSP",
      "properties": {
        "blazeComponentLsp.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the Blaze Component LSP server."
        },
        "blazeComponentLsp.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0"
  }
}
